<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Palisades 3D Fire Sim</title>
  <script src="https://cesium.com/downloads/cesiumjs/releases/1.115/Build/Cesium/Cesium.js"></script>
  <link href="https://cesium.com/downloads/cesiumjs/releases/1.115/Build/Cesium/Widgets/widgets.css" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; background-color: #000; }
    #cesiumContainer { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; }
    #ui-panel {
      position: absolute; top: 15px; left: 15px; background: rgba(0,0,0,0.85);
      color: white; padding: 15px; font-family: Arial, sans-serif; border-radius: 8px; z-index: 10;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
    button { margin-top: 10px; padding: 8px 12px; background: #007acc; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    button:hover { background: #005999; }
  </style>
</head>
<body>
  <div id="ui-panel">
    <h3>Palisades Fire Sim</h3>
    <p>Grid: <b>8x4 Sectors</b></p>
    <p>Status: <span id="sim-status" style="color: #00ff00;">Waiting for RL Model...</span></p>
    <button onclick="testAction()">Simulate RL Helicopter Drop (Sector 10)</button>
  </div>
  
  <div id="cesiumContainer"></div>

  <script>
    // 1. Assign Cesium Access Token
    Cesium.Ion.defaultAccessToken = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJqdGkiOiI2ZGQ0ZjEwNC1jMjlhLTRlNGUtYjllNi0wNDdiYzcxNjkwZDUiLCJpZCI6NDYxNTk3LCJpc3MiOiJodHRwczovL2FwaS5jZXNpdW0uY29tIiwiYXVkIjoidW5kZWZpbmVkX2RlZmF1bHQiLCJpYXQiOjE3ODUyNzI5NjF9.oJ2oHETvVIw69GjOaAxuDiron7whJZf9rx4X3Hm6xNE';

    async function initSim() {
      // Viewer initialization (globe is enabled by default when omitted)
      const viewer = new Cesium.Viewer('cesiumContainer', {
        timeline: false,
        animation: false,
        baseLayerPicker: false
      });

      // Enable lighting for realistic daylight shadows
      viewer.scene.globe.enableLighting = true;

      // Trackpad controls
      viewer.scene.screenSpaceCameraController.tiltEventTypes = [
        Cesium.CameraEventType.RIGHT_DRAG,
        Cesium.CameraEventType.PINCH,
        {
          eventType: Cesium.CameraEventType.LEFT_DRAG,
          modifier: Cesium.KeyboardEventModifier.CTRL
        }
      ];

      // 2. Define Pacific Palisades Coordinates
      const south = 34.030, north = 34.070;
      const west = -118.550, east = -118.500;
      const centerLon = (west + east) / 2.0;

      // 3. LAYER 1: Load Google Photorealistic 3D Tiles
      try {
        const googleTileset = await Cesium.createGooglePhotorealistic3DTileset();
        googleTileset.maximumMemoryUsage = 1024;
        googleTileset.maximumScreenSpaceError = 16;
        viewer.scene.primitives.add(googleTileset);
      } catch (e) {
        console.error("Error loading Google 3D Tiles:", e);
      }

      // 4. LAYER 2: Load OSM 3D Buildings (Light Grey inside grid)
      try {
        const osmBuildings = await Cesium.createOsmBuildingsAsync();
        
        osmBuildings.style = new Cesium.Cesium3DTileStyle({
          show: `\${feature["cesium#longitude"]} >= ${west} && \${feature["cesium#longitude"]} <= ${east} && \${feature["cesium#latitude"]} >= ${south} && \${feature["cesium#latitude"]} <= ${north}`,
          color: 'color("#d1d5db", 0.9)',
          height: {
            conditions: [
              ['Boolean(${feature["building:levels"]})', '${feature["building:levels"]} * 3.5'],
              ['Boolean(${height}) && ${height} > 0', '${height}'],
              ['true', '5.5']
            ]
          }
        });

        viewer.scene.primitives.add(osmBuildings);
      } catch (e) {
        console.error("Error loading OSM Buildings:", e);
      }

      // 5. Fly Camera Target
      viewer.camera.flyTo({
        destination: Cesium.Cartesian3.fromDegrees(centerLon, south - 0.010, 1100.0),
        orientation: {
          heading: Cesium.Math.toRadians(0.0),
          pitch: Cesium.Math.toRadians(-25.0),
          roll: 0.0
        }
      });

      // 6. CREATE 8x4 SECTOR GRID LINES PROJECTED ON EARTH
      const gridEntities = {};
      const latStep = (north - south) / 4;
      const lonStep = (east - west) / 8;

      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 8; c++) {
          const sectorId = r * 8 + c;
          const s = south + r * latStep;
          const n = s + latStep;
          const w = west + c * lonStep;
          const e = w + lonStep;

          gridEntities[sectorId] = viewer.entities.add({
            name: `Sector ${sectorId}`,
            polyline: {
              positions: Cesium.Cartesian3.fromDegreesArray([
                w, s,
                e, s,
                e, n,
                w, n,
                w, s
              ]),
              width: 3,
              material: Cesium.Color.WHITE.withAlpha(0.9),
              clampToGround: true
            }
          });
        }
      }

      // Helper to update sector line colors
      window.setSectorColor = function(sectorId, color, width = 6) {
        const entity = gridEntities[sectorId];
        if (!entity) return;
        entity.polyline.material = color;
        entity.polyline.width = width;
      };

      // Set Sector 10 on Fire initially
      window.setSectorColor(10, Cesium.Color.RED, 6);

      // Action Handler
      window.applyRLAction = function(actionIdx, resourceType) {
        if (resourceType === 'helicopter' || resourceType === 'water_team') {
          window.setSectorColor(actionIdx, Cesium.Color.BLUE, 6);
          document.getElementById('sim-status').innerText = `Helicopter deployed to Sector ${actionIdx}`;
        } else if (resourceType === 'trench_team') {
          window.setSectorColor(actionIdx, Cesium.Color.DARKGRAY, 6);
          document.getElementById('sim-status').innerText = `Trench built in Sector ${actionIdx}`;
        }
      };

      // Poll Python Server for Incoming RL Actions
      setInterval(async () => {
        try {
          const res = await fetch('/get_latest_action');
          const data = await res.json();
          if (data.action_idx !== undefined) {
            window.applyRLAction(data.action_idx, data.resource_type);
          }
        } catch (e) {}
      }, 500);
    }

    initSim();

    function testAction() {
      if (window.applyRLAction) window.applyRLAction(10, 'helicopter');
    }
  </script>
</body>
</html>
